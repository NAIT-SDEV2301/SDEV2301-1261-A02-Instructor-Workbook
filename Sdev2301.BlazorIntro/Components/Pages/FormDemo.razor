@page "/form-demo"

<PageTitle>Form Demo</PageTitle>

<h1>Form Demo</h1>

<label class="form-label" for="name">Product name</label>
<input id="name" class="form-control" @bind="_name" @bind:event="oninput"/>

<p class="mt-3">Current value: @_name</p>

@code {
    private string _name = string.Empty;
}
