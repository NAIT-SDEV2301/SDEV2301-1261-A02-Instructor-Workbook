@page "/products"
@layout ProductLayout
@* @using Sdev2301.BlazorIntro.Models *@

<PageTitle>Products</PageTitle>
<h3>Products</h3>

<p>There are @_products.Count products.</p>
<p>Last refreshed: @DateTime.Now.ToLongTimeString()</p>

<div class="mb-3">
    <label class="form-label" for="productName">New product name</label>
    <input id="productName" class="form-control"
        @bind="NewProductName" />
</div>

<p>Preview: @NewProductName</p>

<button class="btn btn-primary" @onclick="AddProduct">
    Add Sample Product
</button>

<ProductCard Sku="TEST-001"
             Name="Test Product"
             Price="19.99m"
             IsActive="true" />

<table class="table">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Name</th>
            <th>Price</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in _products)
        {
            <tr>
                <td>@product.Sku</td>
                <td>@product.Name</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.IsActive</td>
            </tr>
        }
    </tbody>
</table>


@code {
    private string NewProductName { get; set; } = string.Empty;

    private List<Product> _products =
        [
            new() { Id = 1, Sku="KEY-100",Name="Keyboard", Price=49.99m, IsActive=true},
            new() { Id = 2, Sku="MOU-200",Name="Mouse", Price=24.99m, IsActive=true},
    ];

    private void AddProduct()
    {
        if (string.IsNullOrWhiteSpace(NewProductName))
        {
            return;
        }

        var nextNumber = _products.Count + 1;
        _products.Add(new Product
        {
            Id = nextNumber,
            Sku = $"NEW-{nextNumber:000}",
            //Name = $"New Product {nextNumber}",
            Name = NewProductName.Trim(),
            Price = Random.Shared.Next(1,100),
            IsActive = true
        });

        NewProductName = string.Empty;
    }

    // private class Product
    // {
    //     public int Id { get; set; }
    //     public string Sku { get; set; } = string.Empty;
    //     public string Name { get; set; } = string.Empty;
    //     public decimal Price { get; set; }
    //     public bool IsActive { get; set; }
    // }
}
